# Public, non-secret runtime config only. Anything prefixed EXPO_PUBLIC_ is
# inlined into the JS bundle at OTA/build time.
EXPO_PUBLIC_API_BASE_URL=https://api.octo-hr.com
EXPO_PUBLIC_PRIVACY_URL=https://octo-hr.com/privacy
EXPO_PUBLIC_SUPPORT_URL=https://octo-hr.com/support
EXPO_PUBLIC_PUSH_REGISTRATION_ENABLED=0
# Auth Wave 2 — required for canary/production OTAs (also defaulted in app.config.js)
EXPO_PUBLIC_LOCAL_PIN_UNLOCK=1
EXPO_PUBLIC_LOCAL_BIOMETRIC_UNLOCK=1
EXPO_PUBLIC_LOCAL_AUTO_LOCK=1
EXPO_PUBLIC_LOCAL_AUTO_LOCK_BIOMETRIC=1
