{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://staging-api.wathefni.ai",
        "EXPO_PUBLIC_PUSH_REGISTRATION_ENABLED": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://staging-api.wathefni.ai",
        "EXPO_PUBLIC_PUSH_REGISTRATION_ENABLED": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "internal",
      "channel": "canary",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.wathefni.ai",
        "EXPO_PUBLIC_PUSH_REGISTRATION_ENABLED": "1",
        "EXPO_PUBLIC_LOCAL_PIN_UNLOCK": "1",
        "EXPO_PUBLIC_LOCAL_BIOMETRIC_UNLOCK": "1",
        "EXPO_PUBLIC_LOCAL_AUTO_LOCK": "1",
        "EXPO_PUBLIC_LOCAL_AUTO_LOCK_BIOMETRIC": "1",
        "EXPO_PUBLIC_HR_WORKSPACE_ENABLED": "1",
        "EXPO_PUBLIC_WATHEFNI_PRODUCTION_RELEASE": "1"
      }
    },
    "store": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "production",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.wathefni.ai",
        "EXPO_PUBLIC_PUSH_REGISTRATION_ENABLED": "1",
        "EXPO_PUBLIC_LOCAL_PIN_UNLOCK": "1",
        "EXPO_PUBLIC_LOCAL_BIOMETRIC_UNLOCK": "1",
        "EXPO_PUBLIC_LOCAL_AUTO_LOCK": "1",
        "EXPO_PUBLIC_LOCAL_AUTO_LOCK_BIOMETRIC": "1",
        "EXPO_PUBLIC_HR_WORKSPACE_ENABLED": "1",
        "EXPO_PUBLIC_WATHEFNI_PRODUCTION_RELEASE": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
