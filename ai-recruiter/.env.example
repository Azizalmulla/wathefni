# Database
DATABASE_URL=postgresql://recruiter:recruiter@localhost:5432/ai_recruiter

# Anthropic (for CV parsing + screening)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# WhatsApp Cloud API (for production — not needed for OpenClaw testing)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=ai-recruiter-verify-token
WATHEFNI_HR_ORCHESTRATOR_URL=http://127.0.0.1:8010/orchestrator/whatsapp-turn

# File Storage
UPLOAD_DIR=./uploads

# Google Sheets dashboard sync, powered by gog CLI
GOOGLE_SHEET_ID=
GOOGLE_ACCOUNT=
GOG_BIN=gog
EMPLOYEES_SHEET_NAME=Employees
COMPLIANCE_SHEET_NAME=Compliance

# App
SECRET_KEY=change-this-to-a-random-string
DEBUG=true

# HR-0 quarantine: /internal/* disabled by default. Enable only for isolated local harnesses.
LEGACY_AI_RECRUITER_INTERNAL_ENABLED=0
LEGACY_AI_RECRUITER_INTERNAL_TOKEN=
