+                    f"""
+                    SELECT COUNT(*) AS n
+                    FROM applications
+                    WHERE company_code=%s
+                      AND upper(position_code)=upper(%s)
+                      AND {predicate}
+                    """,
+                    (company_code, position_code),
+                )
+                row = cur.fetchone() or {}
+        if isinstance(row, dict):
+            return int(row.get("n") or 0)
+        if isinstance(row, (list, tuple)) and row:
+            return int(row[0] or 0)
+    except Exception:
+        return 0
+    return 0
