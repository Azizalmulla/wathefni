+@app.get("/orchestrator/debug/intake-readiness")
+def internal_intake_readiness(
+    run_safe_scans: bool = Query(default=True),
+    _internal: dict[str, Any] = Depends(require_internal_access),
+):
+    """Dark readiness for durable email ingress adapters (inbound remains off)."""
+    from intake_malware_scanner import build_malware_scanner_from_env, signature_age_hours
+    from intake_quarantine_storage import build_quarantine_storage_from_env
+    import tempfile
+
+    config = durable_email_ingress_config()
+    storage = build_quarantine_storage_from_env(WORKSPACE)
+    scanner = build_malware_scanner_from_env()
+    storage_health = storage.health() if hasattr(storage, "health") else {"ok": False}
+    scanner_health = scanner.health()
+    scans: dict[str, Any] = {}
+    if run_safe_scans:
+        with tempfile.TemporaryDirectory(prefix="intake-ready-") as tmp:
+            clean = Path(tmp) / "clean.pdf"
+            clean.write_bytes(b"%PDF-1.4\n1 0 obj<<>>endobj\ntrailer<<>>\n%%EOF\n")
+            eicar = Path(tmp) / "eicar.txt"
+            eicar.write_bytes(
+                b"X5O!P%@AP[4\\PZX54(P^)7CC)7}$EICAR-STANDARD-ANTIVIRUS-TEST-FILE!$H+H*"
+            )
+            clean_result = scanner.scan_path(clean)
+            eicar_result = scanner.scan_path(eicar)
+            scans = {
+                "clean_pdf": clean_result.to_record(),
+                "eicar": eicar_result.to_record(),
+                "clean_ok": clean_result.state == "clean",
+                "eicar_detected": eicar_result.state == "malware",
+            }
+    sig = scanner_health.get("signature_version") or scans.get("clean_pdf", {}).get("signature_version")
+    return json_safe(
+        {
+            "inbound_enabled": inbound_email_enabled(),
+            "sender_acknowledgment": (
+                str(os.environ.get("WATHEFNI_SENDER_ACKNOWLEDGMENT") or "off").strip().lower()
+            ),
+            "quarantine_backend": getattr(storage, "backend_name", None),
+            "quarantine_root": str(config.quarantine_root),
+            "storage": storage_health,
+            "scanner": scanner_health,
+            "signature_age_hours": signature_age_hours(sig if isinstance(sig, str) else None),
+            "signing_secret_configured": bool(
+                str(os.environ.get("WATHEFNI_INTAKE_QUARANTINE_SIGNING_SECRET") or "").strip()
+            ),
+            "postmark_inbound_secret_configured": bool(inbound_postmark_secret()),
+            "limits": {
+                "max_webhook_body_bytes": config.max_webhook_body_bytes,
+                "max_attachments": config.max_attachments,
+                "max_file_bytes": config.max_file_bytes,
+                "max_total_attachment_bytes": config.max_total_attachment_bytes,
+                "max_pdf_pages": config.max_pdf_pages,
+                "per_tenant_concurrency": config.per_tenant_concurrency,
+            },
+            "safe_scans": scans,
+        }
+    )
+
