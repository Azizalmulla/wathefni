# Mobile E2E release harness credentials (DO NOT COMMIT secrets)
# Copy to ops/mobile-e2e/.env.local (gitignored) or use ~/.config/wathefni/e2e.env

MOBILE_E2E_API_BASE=https://api.wathefni.ai
MOBILE_E2E_HR_COMPANY=WATHEFNI
MOBILE_E2E_HR_EMAIL=
MOBILE_E2E_HR_PASSWORD=
MOBILE_E2E_PIN=246810
MOBILE_E2E_EMPLOYEE_BEARER=
# Leave IDs come from provision-leave-fixture.py → ~/.config/wathefni/e2e-fixtures.env
MOBILE_E2E_LEAVE_ID=
MOBILE_E2E_LEAVE_APPROVE_ID=
MOBILE_E2E_LEAVE_REJECT_ID=

# Maestro mirrors (optional aliases)
MAESTRO_HR_COMPANY=WATHEFNI
MAESTRO_HR_EMAIL=
MAESTRO_HR_PASSWORD=
MAESTRO_PIN=246810
MAESTRO_EMPLOYEE_PHONE=
MAESTRO_EMPLOYEE_CODE=
MAESTRO_LEAVE_ID=
MAESTRO_LEAVE_REJECT_ID=

# BrowserStack App Automate (never commit real values)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_APP_URL=
BROWSERSTACK_IPA_PATH=
BROWSERSTACK_DEVICES=iPhone 15-17.0
MOBILE_E2E_RUNTIME=browserstack
MOBILE_E2E_SUITE=bs-smoke
