# ---------------------------------------------------------------------------
# Riders Delivery environment template
# ---------------------------------------------------------------------------
# Copy to `.env`, then fill in secrets. `.env` is gitignored.
# `deploy.sh` sources this file, so every var listed here should be kept in
# sync with what the deploy and runtime code actually reads.
# ---------------------------------------------------------------------------

# --- Riders backend -------------------------------------------------------
RIDERS_API_BASE_URL=https://order-riders.trywebsight.com/api
RIDERS_GRID_API_BASE_URL=https://app-order.tryriders.com/api
RIDERS_API_KEY=
RIDERS_GRID_API_KEY=
RIDERS_BEARER_TOKEN=
RIDERS_INTEGRATIONS_URL=https://order-riders.trywebsight.com/admin/integrations
RIDERS_DOCS_URL=https://order-riders.trywebsight.com/docs/api
RIDERS_SUPPORT_NUMBER=1880999
RIDERS_ESCALATION_PHONE=
RIDERS_B2B_CONTACT_PHONE=69039993
RIDERS_EXECUTIVE_PHONE=90010001

# --- Pricing runtime ------------------------------------------------------
RIDERS_PRICING_SOURCE_MODE=published_preferred
RIDERS_PRICING_PUBLISHED_PATH=/Users/azizalmulla/Desktop/claw/delivery/workspaces/riders/data/pricing.published.json
RIDERS_PRICING_RESOLVER_OVERLAY_PATH=/Users/azizalmulla/Desktop/claw/delivery/workspaces/riders/data/pricing.resolver.overlay.json
RIDERS_PRICING_ADMIN_ALLOWLIST=

# Graduated-response for the `verifyAreaEvidence` smuggle defense. Default ON
# (1). When ON, if the customer's raw token doesn't resolve but the LLM's
# canonical does AND there is a plausible similarity link, the resolver
# returns `area_needs_clarification` with `closest_candidates` so the LLM can
# re-call with `pickup_area_id` (if confident) or confirm with the customer.
# Fixes obscure-area + Arabizi misses (e.g. "om il namel" → Umm Al-Namel
# Island) without silently accepting the model's claim. Set to 0 to revert
# to the strict binary reject.
RIDERS_AREA_GRADUATED_RESPONSE=1

# Deterministic post-LLM defense layer that scans every outbound reply for
# factually-ungrounded claims (field-rejection without evidence, price
# mismatch vs. the authoritative quote, "order placed" assertions without
# a submitted-stage transition) and substitutes a safe deterministic reply
# derived from `next_required_action`. Default ON. Set to 0 to disable for
# emergency rollback only; leaving it on is safer than sending a
# hallucinated reply that contradicts server-side state.
RIDERS_HALLUCINATION_GUARD_ENABLED=1

# --- Behavior policy ------------------------------------------------------
RIDERS_BEHAVIOR_POLICY_PUBLISHED_PATH=/Users/azizalmulla/Desktop/claw/delivery/workspaces/riders/data/behavior-policy.published.json
RIDERS_BEHAVIOR_ADMIN_ALLOWLIST=

# --- Pricing sheet (authoring input) --------------------------------------
RIDERS_PRICING_SHEET_ID=1I6QjKlfx2gA-dQ2q1tXlmj_wV0TtPgri06ZDEjjXisU
RIDERS_PRICING_SHEET_NAME=export-38-areas
RIDERS_PRICING_SHEET_HEADER_ROW=1
GOG_BIN=gog
GOG_ACCOUNT=
GOG_KEYRING_PASSWORD=
WRITE_ACTIONS_ENABLED=false

# --- AI Octopus channel ---------------------------------------------------
AI_OCTOPUS_BASE_URL=https://app.ai-octopus.com
# REQUIRED for deploy.sh — bearer token for Octopus outbound API calls.
AI_OCTOPUS_BEARER_TOKEN=
# Shared token the Octopus webhook uses to authenticate inbound calls.
AI_OCTOPUS_WEBHOOK_TOKEN=
AI_OCTOPUS_OPENCLAW_AGENT=riders
AI_OCTOPUS_ADMIN_OPENCLAW_AGENT=riders-admin
AI_OCTOPUS_ADMIN_ALLOWLIST=
AI_OCTOPUS_TYPING_ENABLED=true
AI_OCTOPUS_TYPING_REFRESH_MS=4000

# --- Public webhook / reverse proxy ---------------------------------------
RIDERS_PUBLIC_WEBHOOK_HOST=api.riderskw.com
RIDERS_PUBLIC_WEBHOOK_URL=https://api.riderskw.com/webhook
RIDERS_PUBLIC_WEBHOOK_UPSTREAM=127.0.0.1:18790
RIDERS_CADDY_SITE_PATH=/etc/caddy/Caddyfile
RIDERS_CADDY_ACCESS_LOG=/var/log/caddy/riders-delivery-access.json

# --- Tracking provider ----------------------------------------------------
RIDERS_TRACKING_PROVIDER=
FLEETRUNNR_API_BASE_URL=
FLEETRUNNR_BEARER_TOKEN=

# --- Customer memory / runtime --------------------------------------------
RIDERS_CUSTOMER_MEMORY_DIR=

# --- Model providers ------------------------------------------------------
OPENAI_API_KEY=
MINIMAX_API_KEY=
VOYAGE_API_KEY=

# --- OpenClaw gateway -----------------------------------------------------
OPENCLAW_PROFILE=delivery
OPENCLAW_GATEWAY_PORT=18790
# REQUIRED. Must be set to a non-placeholder value before `deploy.sh` will run.
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME_DELIVERY_TOKEN

# --- One-brain feature flag -----------------------------------------------
# One-brain is now permanent in octopus-channel (hardcoded). The legacy
# turn-interpreter LLM was deleted. This env var only controls the
# `riders-tools` deterministic order-guard path (see
# `plugins/shared/order-guard.ts` + `scripts/eval-one-brain.mjs`).
# Set to 1/true/on in production; leave blank in local dev if you want
# the legacy riders-tools guard behavior for debugging.
RIDERS_ONE_BRAIN=1

# --- Transcript refinement model (audio STT post-processing) --------------
# OpenAI model used by `refineTranscriptWithLlm` to clean up raw audio
# transcripts. Defaults to gpt-5.4 if unset.
RIDERS_TRANSCRIPT_REFINE_MODEL=
# Post-STT LLM refinement is OFF by default (saves ~2-3s per voice message).
# Whisper with the domain vocab prompt is accurate enough for Kuwaiti Arabic.
# Set to 1 to re-enable if voice accuracy regresses.
RIDERS_TRANSCRIPT_REFINE_ENABLED=0

# --- Inbound debounce window (coalesces message bursts) -------------------
# How long we wait after an inbound text message before processing the turn,
# so rapid-fire "hi", "need a driver", "from Salmiya" get bundled into one
# LLM call. Default 3000 ms. Saves ~2s per message vs the old 5000 ms.
# Media (audio/image/location) uses RIDERS_INBOUND_MEDIA_DEBOUNCE_MS and
# falls back to the text value when unset.
RIDERS_INBOUND_DEBOUNCE_MS=3000
RIDERS_INBOUND_MEDIA_DEBOUNCE_MS=

# --- Live (destructive) smoke test ----------------------------------------
# These only matter when running `scripts/smoke-test-live-riders-flow.sh`.
# RIDERS_LIVE_SMOKE_REPLY_TARGET MUST point to a dedicated test WhatsApp
# number. The harness refuses to run if this looks like a production number.
RIDERS_LIVE_SMOKE_REPLY_TARGET=
RIDERS_LIVE_SMOKE_RECIPIENT_PHONE=66565431
RIDERS_LIVE_SMOKE_VPS_HOST=root@72.61.106.61
RIDERS_LIVE_SMOKE_REMOTE_ENV_PATH=/opt/riders-delivery/.env
RIDERS_LIVE_SMOKE_PROFILE=delivery
RIDERS_LIVE_SMOKE_AGENT_ID=riders
RIDERS_LIVE_SMOKE_GATEWAY_HOST=127.0.0.1
RIDERS_LIVE_SMOKE_GATEWAY_PORT=18790
RIDERS_LIVE_SMOKE_WEBHOOK_PATH=/webhook
RIDERS_LIVE_SMOKE_TIMEOUT_MS=45000
RIDERS_LIVE_SMOKE_POLL_MS=2000
RIDERS_LIVE_SMOKE_PICKUP_INPUT=Farwaniya
RIDERS_LIVE_SMOKE_DROPOFF_INPUT=Hawalli
RIDERS_LIVE_SMOKE_PICKUP_EXPECTED=Farwaniya
RIDERS_LIVE_SMOKE_DROPOFF_EXPECTED=Hawalli
RIDERS_LIVE_SMOKE_PICKUP_ADDRESS=Block 1, Street 1, House 1
RIDERS_LIVE_SMOKE_DROPOFF_ADDRESS=Block 2, Street 2, House 2
