{
  "meta": {
    "lastTouchedVersion": "2026.4.14",
    "lastTouchedAt": "2026-04-17T00:00:00.000Z"
  },
  "update": {
    "channel": "beta"
  },
  "models": {
    "providers": {
      "openai": {
        "baseUrl": "https://api.openai.com/v1",
        "apiKey": "${OPENAI_API_KEY}",
        "models": [
          {
            "id": "gpt-5.4",
            "name": "GPT-5.4",
            "api": "openai-responses",
            "reasoning": true,
            "input": ["image", "text"],
            "contextWindow": 400000,
            "maxTokens": 16384
          },
          {
            "id": "gpt-5.4-mini",
            "name": "GPT-5.4 mini",
            "api": "openai-responses",
            "reasoning": true,
            "input": ["image", "text"],
            "contextWindow": 400000,
            "maxTokens": 16384
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai/gpt-5.4"
      },
      "models": {
        "openai/gpt-5.4": {
          "params": {
            "transport": "auto",
            "openaiWsWarmup": true,
            "responsesServerCompaction": true,
            "reasoning": { "effort": "medium" },
            "text": { "verbosity": "low" }
          }
        },
        "openai/gpt-5.4-mini": {
          "params": {
            "transport": "auto",
            "openaiWsWarmup": true,
            "responsesServerCompaction": true,
            "reasoning": { "effort": "medium" },
            "text": { "verbosity": "low" }
          }
        }
      },
      "workspace": "/opt/riders-delivery/workspaces/riders",
      "bootstrapMaxChars": 50000,
      "bootstrapTotalMaxChars": 180000,
      "compaction": {
        "mode": "safeguard",
        "reserveTokensFloor": 290000,
        "maxHistoryShare": 0.5,
        "recentTurnsPreserve": 5,
        "identifierPolicy": "strict",
        "postCompactionSections": [
          "Session Start",
          "Runtime Contract",
          "Execution Contract",
          "Default Follow-Through",
          "Stateful Short-Followup Interpretation",
          "Done Criteria",
          "Messaging Rules",
          "Hard Separation"
        ],
        "customInstructions": "This is a Riders delivery conversation. The server injects structured facts (booking_draft, active_quoted_route, missing_fields, stage, quoted_price, pending_shared_location) into the system context on every turn. Do NOT re-preserve those values in your summary — they are already carried forward structurally, and duplicating them in prose just burns tokens. Instead, preserve with high fidelity what is NOT in structured state: open questions the customer asked that have not yet been answered; pending clarifications still awaiting customer input (pickup-vs-delivery role of a shared location pin, area disambiguation, option-class ambiguity); the customer's last explicit intent (booking, pricing, tracking, complaint, cancel, handoff) and any stated constraints (timing, special instructions, recipient unavailable, etc.); any correction the customer made that a later turn depends on. You may compress or omit: repeated acknowledgements, greetings, pleasantries; already-answered informational questions (coverage, hours, FAQ); intermediate tool call echoes whose results are already committed to state; verbatim option lists and prices (those live in active_quoted_route). Do NOT invent values — if something was never captured, leave it absent.",
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 10000,
          "forceFlushTranscriptBytes": "2mb"
        }
      },
      "memorySearch": {
        "provider": "openai",
        "model": "text-embedding-3-small",
        "query": {
          "hybrid": {
            "enabled": true,
            "vectorWeight": 0.7,
            "textWeight": 0.3,
            "candidateMultiplier": 4
          }
        }
      },
      "maxConcurrent": 4,
      "subagents": { "maxConcurrent": 8 },
      "thinkingDefault": "medium"
    },
    "list": [
      {
        "id": "riders",
        "workspace": "/opt/riders-delivery/workspaces/riders",
        "model": { "primary": "openai/gpt-5.4" },
        "tools": { "deny": ["message"] },
        "thinkingDefault": "medium"
      },
      {
        "id": "riders-mini",
        "workspace": "/opt/riders-delivery/workspaces/riders",
        "model": { "primary": "openai/gpt-5.4-mini" },
        "tools": { "deny": ["message"] },
        "thinkingDefault": "medium"
      },
      {
        "id": "riders-admin",
        "workspace": "/opt/riders-delivery/workspaces/riders-admin",
        "model": { "primary": "openai/gpt-5.4-mini" },
        "tools": { "deny": ["exec"] },
        "thinkingDefault": "medium"
      }
    ]
  },
  "bindings": [],
  "messages": {
    "responsePrefix": "",
    "ackReactionScope": "group-mentions",
    "inbound": { "debounceMs": 1000 }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "session": {
    "dmScope": "per-channel-peer",
    "reset": { "mode": "idle", "idleMinutes": 1440 }
  },
  "channels": {
    "whatsapp": {
      "enabled": false,
      "dmPolicy": "pairing",
      "allowFrom": [],
      "groupPolicy": "allowlist",
      "debounceMs": 0,
      "accounts": {
        "default": {
          "enabled": false,
          "dmPolicy": "pairing",
          "allowFrom": [],
          "groupPolicy": "allowlist",
          "debounceMs": 0
        }
      },
      "mediaMaxMb": 50
    },
    "telegram": {
      "enabled": false,
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist",
      "streaming": { "mode": "partial" },
      "linkPreview": false
    },
    "octopus": {
      "enabled": true,
      "agentId": "riders",
      "dmPolicy": "open",
      "allowFrom": [],
      "typingEnabled": true,
      "typingRefreshMs": 9000,
      "webhookPath": "/webhook",
      "accounts": {
        "default": { "enabled": true }
      },
      "behaviorPolicyPublishedPath": "/opt/riders-delivery/workspaces/riders/data/behavior-policy.published.json"
    }
  },
  "gateway": {
    "port": 18790,
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "trustedProxies": ["127.0.0.1/8", "::1/128"]
  },
  "skills": {
    "install": { "nodeManager": "npm" }
  },
  "plugins": {
    "load": {
      "paths": [
        "/opt/riders-delivery/plugins/riders-tools",
        "/opt/riders-delivery/plugins/octopus-channel"
      ]
    },
    "entries": {
      "openai": {
        "enabled": true,
        "config": { "personality": "off" }
      },
      "riders-tools": {
        "enabled": true,
        "config": {
          "pricing": {
            "sourceMode": "published_preferred",
            "publishedPath": "/opt/riders-delivery/workspaces/riders/data/pricing.published.json",
            "resolverOverlayPath": "/opt/riders-delivery/workspaces/riders/data/pricing.resolver.overlay.json",
            "adminAllowlist": [],
            "googleSheet": {
              "spreadsheetId": "${RIDERS_PRICING_SHEET_ID}",
              "sheetName": "export-38-areas",
              "headerRow": 1
            }
          },
          "behavior": {
            "publishedPath": "/opt/riders-delivery/workspaces/riders/data/behavior-policy.published.json",
            "adminAllowlist": []
          }
        }
      },
      "octopus-channel": {
        "enabled": true
      },
      "telegram": {
        "enabled": true
      }
    }
  },
  "env": {
    "RIDERS_SINGLE_LIFECYCLE_ENGINE": "1",
    "RIDERS_TRACKING_PROVIDER": "fleetrunnr",
    "FLEETRUNNR_API_BASE_URL": "https://api.fleetrunnr.net/rest/v1",
    "FLEETRUNNR_BEARER_TOKEN": "${FLEETRUNNR_BEARER_TOKEN}"
  },
  "tools": {
    "media": {
      "audio": {
        "enabled": true,
        "maxBytes": 20971520,
        "models": [
          { "provider": "openai", "model": "gpt-4o-transcribe" }
        ]
      }
    }
  }
}
