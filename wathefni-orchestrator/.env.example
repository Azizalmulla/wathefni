# Wathefni orchestrator — example environment (do not put real secrets here).
#
# Protected flags (keep OFF in production unless explicitly approved):
#   WATHEFNI_EMPLOYEE_APP=off
#   WATHEFNI_COMPANY_CHANNEL_ACCOUNTS=off
#   WATHEFNI_ONBOARDING_SEED=off
#
# Setup Console (already enabled where approved):
#   WATHEFNI_SETUP_CONSOLE_ENABLED=on
#   WATHEFNI_SETUP_CONSOLE_V2=on
#   WATHEFNI_WORKSPACE_BOOT=on
#
# Phase 7D — company channel accounts (staging/design only):
# When OFF (default): Setup Console card is visible read-only; mutations return 404;
# readiness is not blocked; outbound/inbound routing ignores company_channel_accounts
# and uses the shared platform WhatsApp account.
# When ON (staging only, throwaway companies): registry mutations work; routing may
# select a company-owned provider_account_id for permitted audiences (candidate|
# employee) if the account is active and the provider id exists in local sender
# config. Unknown/pending/disabled/audience-mismatch → shared fallback.
# Never store provider tokens/API keys in company_channel_accounts.
WATHEFNI_COMPANY_CHANNEL_ACCOUNTS=off
WATHEFNI_EMPLOYEE_APP=off

# Delivery: use dry_run for staging mocked sends (no live WhatsApp).
# WATHEFNI_DELIVERY_MODE=dry_run
