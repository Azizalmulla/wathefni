[Unit]
Description=Wathefni HR Orchestrator (STAGING — dry-run delivery, internal/localhost only)
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/wathefni/staging/orchestrator
Environment=WATHEFNI_WORKSPACE=/opt/wathefni/staging/workspace
Environment=WATHEFNI_POSTGRES_ENV=/root/.openclaw/secrets/postgres.staging.env
Environment=WATHEFNI_ENV=staging
Environment=WATHEFNI_EXPECTED_DATABASE_HOST=127.0.0.1
Environment=WATHEFNI_EXPECTED_DATABASE_PORT=5432
Environment=WATHEFNI_EXPECTED_DATABASE_NAME=wathefni_staging
Environment=WATHEFNI_DATABASE_ENVIRONMENT_MARKER=wathefni-staging-hr2-isolation-v1
Environment=WATHEFNI_DASHBOARD_DIST=/opt/wathefni/staging/dashboard-dist
Environment=WATHEFNI_DELIVERY_MODE=dry_run
Environment=PUBLIC_CANDIDATE_BASE_URL=http://127.0.0.1:8011
Environment=WATHEFNI_TOOLCALL_ORCHESTRATOR_ENABLED=true
Environment=WATHEFNI_DB_POOL_MAX=8
Environment=HOME=/root
Environment=XDG_CONFIG_HOME=/root/.config
EnvironmentFile=/root/.openclaw/secrets/gog-keyring.env
# Bound to localhost only — reach it via SSH tunnel (see DEPLOY_RUNBOOK.md). No public domain.
ExecStart=/opt/wathefni/orchestrator/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8011
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
