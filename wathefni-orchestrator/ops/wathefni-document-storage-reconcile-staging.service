[Unit]
Description=Wathefni STAGING document storage reconciliation
After=network-online.target postgresql.service wathefni-orchestrator-staging.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/wathefni/staging/orchestrator
Environment=WATHEFNI_WORKSPACE=/opt/wathefni/staging/workspace
Environment=WATHEFNI_POSTGRES_ENV=/root/.openclaw/secrets/postgres.staging.env
Environment=HOME=/root
Environment=XDG_CONFIG_HOME=/root/.config
EnvironmentFile=/root/.openclaw/secrets/gog-keyring.env
ExecStart=/opt/wathefni/orchestrator/.venv/bin/python document-storage-reconcile-worker.py --limit 50
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
