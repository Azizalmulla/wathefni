[Unit]
Description=Bounded WATHEFNI automatic post-extraction classification
After=wathefni-orchestrator.service

[Service]
Type=oneshot
WorkingDirectory=/opt/wathefni/orchestrator
Environment=WATHEFNI_WORKSPACE=/root/.openclaw/workspaces/company-wathefni
Environment=WATHEFNI_POSTGRES_ENV=/root/.openclaw/secrets/postgres.env
Environment=WATHEFNI_ENV=production
Environment=WATHEFNI_EXPECTED_DATABASE_HOST=127.0.0.1
Environment=WATHEFNI_EXPECTED_DATABASE_PORT=5432
Environment=WATHEFNI_EXPECTED_DATABASE_NAME=wathefni
Environment=WATHEFNI_DATABASE_ENVIRONMENT_MARKER=wathefni-production-isolation-v1
Environment=WATHEFNI_TALENT_POOL_AUTO_EMAIL_CLASSIFICATION=on
Environment=WATHEFNI_TALENT_POOL_AUTO_EMAIL_CLASSIFICATION_TENANTS=WATHEFNI
Environment=WATHEFNI_TALENT_POOL_AUTO_EMAIL_CLASSIFICATION_STARTED_AT=__CANARY_STARTED_AT__
Environment=WATHEFNI_TALENT_POOL_AUTO_EMAIL_CLASSIFICATION_RECIPIENT=92d69b51cdadf3b594fc08710326ff6b@inbound.postmarkapp.com
Environment=WATHEFNI_TALENT_POOL_AUTO_EMAIL_CLASSIFICATION_MAX_ATTEMPTS=3
ExecStart=/opt/wathefni/orchestrator/.venv/bin/python /opt/wathefni/orchestrator/talent_pool_auto_email_classification.py --limit 1
Nice=10

